{
  "manifest_version": 3,
  "name": "DeepStack — Full Tech Stack & Architecture Inspector",
  "short_name": "DeepStack",
  "version": "1.1.0",
  "minimum_chrome_version": "111",
  "homepage_url": "https://github.com/EmmanouelKontos/deepstack",
  "description": "Precision full-stack technology profiler: 196+ signatures with versions & evidence trails, backend/DNS discovery, API endpoints, security grading, and design tokens.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "DeepStack — Inspect Full Tech Stack",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/main-world-probe.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/isolated-collector.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
